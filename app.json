{
  "expo": {
    "name": "Gastos Gang",
    "slug": "gastos-gang",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/gastos-gang-icon.png",
    "scheme": "gastosgang",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/gastos-gang-icon.png"
    },
    "android": {
      "package": "com.accelvivas.gastosgang",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#111714",
        "foregroundImage": "./assets/images/gastos-gang-adaptive.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/gastos-gang-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111714",
          "image": "./assets/images/gastos-gang-logo.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/payment-notification.png",
          "color": "#C9FC39",
          "defaultChannel": "payment-reminders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a2623a63-5637-4795-8815-61c7952c6e2f"
      }
    },
    "owner": "accelvivas"
  }
}
